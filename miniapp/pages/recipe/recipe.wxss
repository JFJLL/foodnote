.state {
  padding: 32rpx;
  color: #6d756f;
}

.error {
  color: #d94e38;
}

.detail {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero {
  overflow: hidden;
}

.cover {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  background: linear-gradient(135deg, #f5f7f2, #f7dfa9, #f4b3a5);
  color: #6d756f;
  font-weight: 900;
}

.cover image {
  width: 100%;
  height: 100%;
}

.hero-body,
.section {
  padding: 26rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.desc {
  display: block;
  margin-top: 12rpx;
  color: #6d756f;
  font-size: 27rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-button,
.link-button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
}

.link-button {
  border: 1px solid rgba(30, 39, 34, 0.15);
  border-radius: 14rpx;
  background: #ffffff;
  color: #1e2722;
}

.danger-button {
  margin: 18rpx 0 0;
  height: 70rpx;
  border: 1px solid rgba(217, 78, 56, 0.3);
  border-radius: 14rpx;
  background: #ffffff;
  color: #d94e38;
  line-height: 70rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1px solid rgba(30, 39, 34, 0.08);
  font-size: 28rpx;
}

.step {
  display: grid;
  grid-template-columns: 52rpx 1fr;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1px solid rgba(30, 39, 34, 0.08);
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #2f6b4f;
  color: #ffffff;
  font-weight: 900;
}

.step-title {
  display: block;
  font-size: 29rpx;
  font-weight: 800;
}

.step-body {
  display: block;
  margin-top: 8rpx;
  color: #4f5b54;
  font-size: 27rpx;
  line-height: 1.55;
}
