.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 6rpx;
  color: #6d756f;
  font-size: 26rpx;
}

.menu-pill {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: #f0b64d;
  font-size: 26rpx;
  font-weight: 800;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.random {
  margin: 0;
  padding: 0 20rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #1e2722;
  color: #ffffff;
  line-height: 58rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.state {
  padding: 32rpx;
  color: #6d756f;
  font-size: 28rpx;
}

.error {
  color: #d94e38;
}

.search-card {
  display: grid;
  grid-template-columns: 1fr 150rpx 104rpx;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
  margin-bottom: 22rpx;
}

.search-card input,
.platform-filter {
  height: 62rpx;
  border-radius: 12rpx;
  background: #f5f7f2;
  padding: 0 18rpx;
  color: #1e2722;
  font-size: 25rpx;
  line-height: 62rpx;
}

.platform-filter {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
  font-weight: 800;
}

.search-card button {
  margin: 0;
  padding: 0;
  height: 62rpx;
  border-radius: 12rpx;
  background: #1f6f4a;
  color: #ffffff;
  line-height: 62rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recipe {
  position: relative;
  display: grid;
  grid-template-columns: 180rpx 1fr;
  min-height: 180rpx;
  overflow: hidden;
}

.recipe-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f7f2, #f7dfa9, #f4b3a5);
  color: #6d756f;
  font-size: 26rpx;
  font-weight: 800;
}

.recipe-cover image {
  width: 100%;
  height: 100%;
}

.recipe-body {
  min-width: 0;
  padding: 22rpx 76rpx 22rpx 22rpx;
}

.recipe-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.recipe-desc {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #6d756f;
  font-size: 25rpx;
  line-height: 1.45;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recipe-meta {
  display: block;
  margin-top: 14rpx;
  color: #8b928d;
  font-size: 22rpx;
}

.add-button {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d94e38;
  color: #ffffff;
  line-height: 52rpx;
  font-size: 34rpx;
  font-weight: 900;
}
