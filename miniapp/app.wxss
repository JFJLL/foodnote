page {
  background: #f5f7f2;
  color: #1e2722;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.safe-page {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 45rpx rgba(39, 56, 43, 0.08);
}

.primary-button {
  border-radius: 14rpx;
  background: #2f6b4f;
  color: #ffffff;
  font-weight: 700;
}
